#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        urn: urn {
            compatible = "zmk,behavior-hold-tap";
            label = "URN";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
              &urn DE_N1 DE_Q   &urn DE_N2 DE_W  &urn DE_N3 DE_E  &urn DE_N4 DE_R      &urn DE_N5 DE_T    &urn DE_N6 DE_Z  &urn DE_N7 DE_U      &urn DE_N8 DE_I  &urn DE_N9 DE_O  &urn DE_N0 DE_P
              &hm LEFT_SHIFT A  &hm LALT S       &hm LCTRL D      &hm RIGHT_COMMAND F  &hm ENTER DE_G     &hm ENTER H      &hm RIGHT_COMMAND J  &hm RCTRL K      &hm RALT L       &hm RIGHT_SHIFT SEMICOLON
&lt 4 ESCAPE  &kp DE_Y          &kp X            &kp C            &kp V                &kp B              &kp N            &kp M                &kp COMMA        &kp DOT          &kp DE_MINUS               &lt 4 ENTER
                                                 &lt 3 BACKSPACE  &lt 1 TAB            &kp SPACE          &kp SPACE        &lt 2 BSPC           &kp ENTER
            >;
        };

        Nav {
            label = "Nav";
            bindings = <
              &kp EXCL        &kp C_VOLUME_DOWN  &kp UP_ARROW      &kp C_VOLUME_UP  &kp DE_LEFT_BRACE          &kp DE_RIGHT_BRACE        &kp NUMBER_7     &kp NUMBER_8         &kp NUMBER_9  &kp DE_QUESTION
              &kp LEFT_SHIFT  &kp LEFT           &kp DOWN          &kp RIGHT        &kp DE_LEFT_BRACKET        &kp DE_RIGHT_BRACKET      &kp NUMBER_4     &kp NUMBER_5         &kp NUMBER_6  &kp DE_MINUS
&kp LEFT_ALT  &trans          &kp C_PREV         &kp C_PLAY_PAUSE  &kp C_NEXT       &kp DE_LEFT_PARENTHESIS    &kp DE_RIGHT_PARENTHESIS  &kp NUMBER_1     &kp NUMBER_2         &kp NUMBER_3  &kp KP_MULTIPLY  &kp DE_PLUS
                                                 &kp PAGE_UP       &trans           &kp PAGE_DOWN              &kp LC(LEFT_ARROW)        &kp KP_NUMBER_0  &kp LC(RIGHT_ARROW)
            >;
        };

        Sym {
            label = "Sym";
            bindings = <
        &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp KP_ASTERISK  &kp SQT  &kp DQT
        &trans    &trans  &trans    &trans      &trans         &trans     &trans         &trans           &trans   &trans
&trans  &trans    &trans  &trans    &trans      &trans         &kp UNDER  &kp EQUAL      &trans           &trans   &kp SLASH  &kp HOME
                          &trans    &trans      &trans         &trans     &trans         &trans
            >;
        };

        Fun {
            label = "Fun";
            bindings = <
        &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans    &trans  &trans  &trans  &trans  &kp F1
        &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &to 5     &trans  &trans  &trans  &trans  &kp F10
&trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans    &trans  &trans  &trans  &trans  &kp F20  &trans
                                 &trans           &trans           &trans    &trans  &trans  &trans
            >;
        };

        Button {
            label = "Button";
            bindings = <
             &bt BT_CLR         &trans    &trans     &trans      &bt BT_SEL 0    &trans      &trans            &trans      &bootloader  &trans
             &kp LGUI           &kp LALT  &kp LCTRL  &kp LSHIFT  &bt BT_SEL 1    &trans      &kp RSHIFT        &kp RCTRL   &kp RALT     &kp RGUI
&bootloader  &ext_power EP_TOG  &trans    &trans     &trans      &bt BT_SEL 2    &trans      &trans            &trans      &trans       &trans    &trans
                                          &trans     &trans      &trans          &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT
            >;
        };

        Gaming {
            bindings = <
            &trans  &trans  &trans     &trans        &trans    &trans  &trans  &trans  &trans  &trans
            &kp A   &kp S   &kp D      &kp F         &mo 6     &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &trans  &trans  &trans     &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
                            &kp LCTRL  &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;

            label = "Gaming";
        };

        Gaming+ {
            bindings = <
         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans  &trans  &trans  &trans  &kp LC(RA(DEL))
         &kp L         &kp O         &kp Y         &kp K         &kp G           &kp F5  &trans  &trans  &trans  &trans
&kp TAB  &to 0         &trans        &trans        &kp NUMBER_6  &kp NUMBER_7    &trans  &trans  &trans  &trans  &trans           &kp LA(F4)
                                     &kp J         &kp I         &kp M           &trans  &trans  &trans
            >;

            label = "Gaming+";
        };
    };
};
